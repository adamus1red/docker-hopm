{
  "extends": [
    "config:best-practices",
    "docker:enableMajor",
    "schedule:nonOfficeHours"
  ],
  "forkProcessing": "enabled",
  "git-submodules": {
    "enabled": true
  },
  "packageRules": [
    {
      "matchUpdateTypes": [
        "major",
        "minor",
        "patch",
        "pin",
        "pinDigest",
        "digest",
        "lockFileMaintenance",
        "rollback",
        "bump",
        "replacement"
      ],
      "automerge": true
    }
  ]
}
